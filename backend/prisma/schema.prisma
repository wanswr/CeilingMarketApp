generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  EMPLOYER
}

enum OrderStatus {
  PENDING
  PUBLISHED
  CLAIMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTE
}

model User {
  id                String         @id @default(uuid())
  phone             String         @unique
  name              String?
  role              Role?
  avatar            String?
  rating            Float          @default(5.0)
  experience        Int?           @default(0)
  ordersCount       Int            @default(0)
  completedOrders   Int            @default(0)
  instagram         String?
  telegram          String?
  isVerified        Boolean        @default(false)
  isTrialUsed       Boolean        @default(false)
  pushToken         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orders            Order[]        @relation("EmployerOrders")
  assignedOrders    Order[]        @relation("WorkerOrders")
  applications      Application[]
  subscription      Subscription?
}

model Order {
  id                String         @id @default(uuid())
  employerId        String
  workerId          String?
  title             String
  address           String
  latitude          Float
  longitude         Float
  date              DateTime

  @@index([status, latitude, longitude]) // V6: Composite index for optimized BBOX spatial queries
  @@index([latitude])
  @@index([longitude])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  price             Float
  details           String?
  status            OrderStatus    @default(PUBLISHED)
  images            String[]
  isPinned          Boolean        @default(false)
  idempotencyKey    String?        @unique
  claimedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  employer          User           @relation("EmployerOrders", fields: [employerId], references: [id])
  worker            User?          @relation("WorkerOrders", fields: [workerId], references: [id])
  applications      Application[]
}

model Application {
  id                String         @id @default(uuid())
  orderId           String
  workerId          String
  idempotencyKey    String?        @unique
  createdAt         DateTime       @default(now())

  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker            User           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([orderId, workerId])
}

model Subscription {
  id                String         @id @default(uuid())
  userId            String         @unique
  activeUntil       DateTime
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}
