
enum AssistantNoteTranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssistantNoteAnalysisStatus {
  IDLE
  PROCESSING
  COMPLETED
  FAILED
  STALE
}

enum AssistantNoteEditProposalStatus {
  PENDING
  APPLIED
  CANCELLED
  EXPIRED
  STALE
}

model AssistantNoteEditProposal {
  id          String                            @id @default(uuid())
  noteId      String
  userId      String
  baseVersion Int
  inputType   String                            @default("TEXT")
  rawInput    String
  operations  Json
  uncertainties Json?
  summary     String?
  status      AssistantNoteEditProposalStatus   @default(PENDING)
  createdAt   DateTime                          @default(now())
  appliedAt   DateTime?

  note        AssistantNote                     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user        User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([userId])
}

enum AssistantReminderStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model AssistantReminder {
  id             String                  @id @default(uuid())
  userId         String
  noteId         String?
  title          String
  description    String?
  scheduledAt    DateTime
  status         AssistantReminderStatus @default(SCHEDULED)
  sourceTaskId   String?
  sourceDateId   String?
  notificationId String?
  idempotencyKey String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           AssistantNote?          @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([noteId])
  @@index([idempotencyKey])
}
