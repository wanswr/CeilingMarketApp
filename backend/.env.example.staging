# App
PORT=3000
NODE_ENV=staging

# API Configuration
API_URL="https://staging-api.ceilingsapp.com/api/"

# Database (Staging Database Instance - Completely Isolated from Prod)
DATABASE_URL="postgresql://<staging_db_user>:<staging_db_password>@<staging_db_host>:5432/ceilingsapp_staging?schema=public"

# Auth (Staging JWT Secret Key)
JWT_SECRET="<generate_secure_staging_jwt_secret_here>"
JWT_EXPIRES_IN="7d"

# CORS
ALLOWED_ORIGINS="https://staging.ceilingsapp.com,http://localhost:8081"

# Redis Cache / Queue (Staging)
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD="<staging_redis_password>"
