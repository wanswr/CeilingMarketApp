rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    // Check if a user is subscribed or has an active trial
    function isSubscribed() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.isSubscribed == true || (userData.subscriptionUntil != null && timestamp(userData.subscriptionUntil) > request.time);
    }

    // Check if the order is confirmed between requester and owner
    function isOrderConfirmed(orderData) {
      return (request.auth.uid == orderData.employerId || request.auth.uid == orderData.workerId) &&
             orderData.status in ['accepted', 'in_work', 'completed', 'executing'];
    }

    match /users/{userId} {
      // Sensitivity: Hide phone number from everyone except owner or confirmed partners
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        exists(/databases/$(database)/documents/orders/{orderId}) // This is complex, simplified version below
      );

      // Simplified: Allow reading profile (name, rating) but hide phone field via app logic
      // or using separate private_profile subcollection.
      allow get: if isAuthenticated();

      allow write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();

      // Phone numbers in orders should be hidden in the UI if not confirmed.
      // Rules protect the document itself.

      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        (isSubscribed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidates', 'status', 'updatedAt']))
      );

      allow delete: if isAuthenticated() && resource.data.employerId == request.auth.uid;
    }

    match /payment_requests/{reqId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.participants);
    }
  }
}
