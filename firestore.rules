rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    // Check if a user is subscribed or has an active trial
    function isSubscribed() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.isSubscribed == true || (userData.subscriptionUntil != null && timestamp(userData.subscriptionUntil) > request.time);
    }

    // Helper to check if requester is involved in a specific order
    function isInvolvedInOrder(orderData) {
      return (orderData.employerId == request.auth.uid || orderData.workerId == request.auth.uid) &&
             orderData.status in ['accepted', 'started', 'finished', 'completed'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /private/data {
        // Only owner or confirmed partner can read private data (phone)
        allow read: if isOwner(userId) ||
          exists(/databases/$(database)/documents/orders) &&
          get(/databases/$(database)/documents/orders).data.isInvolvedInOrder; // This is a conceptual rule, see below

        // Real rule for partner verification:
        // We allow reading if there exists an order where userId is either employer or worker
        // AND the requester is the other party AND status is confirmed.
        allow read: if isOwner(userId) ||
          exists(/databases/$(database)/documents/orders/$(orderId)) &&
          isInvolvedInOrder(get(/databases/$(database)/documents/orders/$(orderId)).data) &&
          (get(/databases/$(database)/documents/orders/$(orderId)).data.employerId == userId ||
           get(/databases/$(database)/documents/orders/$(orderId)).data.workerId == userId);

        allow write: if isOwner(userId);
      }
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.employerId == request.auth.uid ||
        (isSubscribed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidates', 'status', 'updatedAt', 'workerId']))
      );
      allow delete: if resource.data.employerId == request.auth.uid;
    }

    match /payment_requests/{reqId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.participants);
    }

    match /verification_requests/{reqId} {
      allow create: if isAuthenticated();
      allow read: if resource.data.userId == request.auth.uid;
    }
  }
}
